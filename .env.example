APP_NAME=ResolveAI
ENVIRONMENT=development

# openai | google_ai | vertex | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retained for a later switch to Google models.
GEMINI_PROVIDER=google_ai
GEMINI_MODEL=gemini-3.8-flash
# Live voice uses one small routing/reply request; full incident analysis runs after hang-up.
GEMINI_VOICE_MODEL=gemini-3.5-flash-lite
VOICE_REPLY_TIMEOUT_MS=8000
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=

# Required for Vertex AI and recommended for Firestore.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# memory | firestore
DATA_BACKEND=memory
FIRESTORE_COLLECTION=resolveai_cases

FALLBACK_TO_MOCK=false

# Browser-call streaming (Vertex + ADC). File uploads still use GEMINI_TRANSCRIPTION_MODEL.
# Enable speech.googleapis.com and grant the runtime account roles/speech.client.
# auto = google_streaming on Vertex, batch on other providers; batch is an explicit fallback.
LIVE_TRANSCRIPTION_BACKEND=auto
SPEECH_MODEL=chirp_3
SPEECH_LOCATION=us
SPEECH_LANGUAGE=en-IN
VOICE_SILENCE_MS=400

# Log in with Google / Microsoft. A button appears on the log-in page only when both values for that provider are set.
# Register these return addresses with the provider (swap in your Cloud Run URL in production):
#   http://127.0.0.1:8095/api/auth/oauth/google/callback
#   http://127.0.0.1:8095/api/auth/oauth/microsoft/callback
# In production keep the secrets in Secret Manager, not in this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = personal and work accounts; or your directory (tenant) ID to accept only your organisation.
MICROSOFT_TENANT=common
# Sign-in return addresses use PUBLIC_BASE_URL when set (the deploy script sets it to the Cloud Run URL).
